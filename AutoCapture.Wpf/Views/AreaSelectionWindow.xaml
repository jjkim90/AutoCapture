<Window x:Class="AutoCapture.Wpf.Views.AreaSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoCapture.Wpf.Views"
        mc:Ignorable="d"
        Title="AreaSelectionWindow"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="Manual"
        SizeToContent="Manual"
        ShowInTaskbar="False"
        Cursor="Cross"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="Handle" TargetType="Rectangle">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="RadiusX" Value="2" />
            <Setter Property="RadiusY" Value="2" />
            <Setter Property="Fill" Value="White" />
            <Setter Property="Stroke" Value="#FF5C86FF" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HudBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HudEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource HudForegroundBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 선택 영역 밖만 어둡게 -->
        <Path x:Name="Scrim" Fill="#80080A0F" IsHitTestVisible="False" />

        <!-- 거의 투명한 배경이 있어야 선택 영역 안쪽도 클릭을 받는다 -->
        <Canvas x:Name="SelectionCanvas"
                Background="#01000000"
                MouseLeftButtonDown="Canvas_MouseDown"
                MouseMove="Canvas_MouseMove"
                MouseLeftButtonUp="Canvas_MouseUp">

            <Rectangle x:Name="HoverRectangle" Stroke="#FF5C86FF" StrokeThickness="2"
                       StrokeDashArray="4 3" Fill="#145C86FF"
                       IsHitTestVisible="False" Visibility="Collapsed" />

            <Rectangle x:Name="SelectionRectangle" Stroke="#FF5C86FF" StrokeThickness="1.5"
                       Fill="Transparent" Visibility="Collapsed" />

            <Rectangle Style="{StaticResource Handle}" Tag="{x:Static local:SelectionHandle.TopLeft}" Cursor="SizeNWSE" />
            <Rectangle Style="{StaticResource Handle}" Tag="{x:Static local:SelectionHandle.Top}" Cursor="SizeNS" />
            <Rectangle Style="{StaticResource Handle}" Tag="{x:Static local:SelectionHandle.TopRight}" Cursor="SizeNESW" />
            <Rectangle Style="{StaticResource Handle}" Tag="{x:Static local:SelectionHandle.Right}" Cursor="SizeWE" />
            <Rectangle Style="{StaticResource Handle}" Tag="{x:Static local:SelectionHandle.BottomRight}" Cursor="SizeNWSE" />
            <Rectangle Style="{StaticResource Handle}" Tag="{x:Static local:SelectionHandle.Bottom}" Cursor="SizeNS" />
            <Rectangle Style="{StaticResource Handle}" Tag="{x:Static local:SelectionHandle.BottomLeft}" Cursor="SizeNESW" />
            <Rectangle Style="{StaticResource Handle}" Tag="{x:Static local:SelectionHandle.Left}" Cursor="SizeWE" />

            <!-- 크기 -->
            <Border x:Name="SizeBadge" Style="{StaticResource Pill}" CornerRadius="4" Padding="7,3"
                    IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="SizeText" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
            </Border>

            <!-- 선택 후 툴바 -->
            <Border x:Name="Toolbar" Style="{StaticResource Pill}" CornerRadius="22" Padding="6" Cursor="Arrow"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.4" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SummaryText" Margin="12,0,12,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource HudMutedBrush}" />
                    <Button Style="{StaticResource HudButton}" Margin="0,0,6,0" Click="Redraw_Click"
                            ToolTip="지금 영역을 버리고 새로 그립니다. 우클릭이나 Ctrl+드래그로도 됩니다">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="다시 그리기" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HudButton}" Margin="0,0,6,0" Click="Confirm_Click"
                            ToolTip="영역만 정하고 설정 화면으로 돌아갑니다">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="영역 확정" />
                            <TextBlock Text="Enter" Margin="8,0,0,0" Opacity="0.6" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource HudPrimaryButton}" Click="Start_Click"
                            ToolTip="입력 대상 창을 앞으로 가져온 뒤 바로 시작합니다">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="바로 시작" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- 안내 -->
        <Border Style="{StaticResource Pill}" Padding="16,8" Margin="0,20,0,0"
                HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False">
            <TextBlock x:Name="HintText" FontSize="13"
                       Text="창 위에서 클릭하면 창에 맞춤 · 드래그해서 직접 선택 · Esc 취소" />
        </Border>

        <ComboBox x:Name="MonitorPicker" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="12" Cursor="Arrow" ToolTip="캡처할 모니터"
                  DisplayMemberPath="DeviceName" SelectionChanged="MonitorChanged"/>
    </Grid>
</Window>
