<Window x:Class="AutoCapture.Wpf.Views.AreaSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoCapture.Wpf.Views"
        mc:Ignorable="d"
        Title="AreaSelectionWindow" 
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#33000000"
        Topmost="True"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Cursor="Cross"
        PreviewKeyDown="Window_PreviewKeyDown">
    
    <Grid>
        <!-- 전체 화면 캔버스 -->
        <Canvas x:Name="SelectionCanvas"
                Background="Transparent"
                MouseDown="Canvas_MouseDown"
                MouseMove="Canvas_MouseMove"
                MouseUp="Canvas_MouseUp">
            
            <!-- 선택 영역 표시 -->
            <Rectangle x:Name="SelectionRectangle"
                       Stroke="#FF2196F3"
                       StrokeThickness="2"
                       Fill="#332196F3"
                       Visibility="Collapsed">
                <Rectangle.StrokeDashArray>
                    <DoubleCollection>5,5</DoubleCollection>
                </Rectangle.StrokeDashArray>
            </Rectangle>
        </Canvas>
        
        <!-- 크기 정보 표시 -->
        <Border x:Name="InfoBorder"
                Background="#FF424242"
                CornerRadius="4"
                Padding="8,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,20,0,0"
                Visibility="Collapsed">
            <TextBlock x:Name="InfoText"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="Medium"/>
        </Border>
        
        <!-- 안내 메시지 -->
        <Border Background="#FF424242"
                CornerRadius="4"
                Padding="16,8"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,40">
            <TextBlock Foreground="White"
                       FontSize="14"
                       TextAlignment="Center">
                <Run Text="마우스를 드래그하여 캡처 영역을 선택하세요"/>
                <LineBreak/>
                <Run Text="ESC: 취소 | 드래그 후 마우스를 놓으면 자동 확인" FontSize="12" Foreground="#BBFFFFFF"/>
            </TextBlock>
        </Border>
    </Grid>
</Window>