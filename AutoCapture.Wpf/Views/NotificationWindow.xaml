<Window x:Class="AutoCapture.Wpf.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AutoCapture 알림"
        Height="240" Width="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual">

    <Border x:Name="NotificationBorder"
            Background="{StaticResource HudBackgroundBrush}"
            BorderBrush="{StaticResource HudEdgeBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35"/>
        </Border.Effect>

        <Grid Margin="18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Ellipse x:Name="AccentDot" Width="10" Height="10" Margin="0,0,10,0"
                         VerticalAlignment="Center" Fill="{StaticResource HudSuccessBrush}"/>
                <TextBlock x:Name="TitleText"
                           Text="화면 캡처 완료"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource HudForegroundBrush}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="20,8,0,8" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText"
                           Text="메시지"
                           FontSize="13"
                           LineHeight="19"
                           Foreground="{StaticResource HudMutedBrush}"
                           TextWrapping="Wrap"/>
            </ScrollViewer>

            <Button Grid.Row="2"
                    Content="확인"
                    HorizontalAlignment="Right"
                    Style="{StaticResource HudButton}"
                    Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>
