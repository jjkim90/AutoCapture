<Window x:Class="AutoCapture.Wpf.Views.CaptureHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AutoCapture.Wpf.Controls"
        xmlns:vm="clr-namespace:AutoCapture.Wpf.ViewModels"
        Title="AutoCapture 진행 상태"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic"
        Foreground="{StaticResource HudForegroundBrush}">

    <Window.Resources>
        <Style x:Key="ShowWhenLive" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:HudState.Running}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:HudState.Paused}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShowWhenRunning" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:HudState.Running}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShowWhenPaused" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:HudState.Paused}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShowWhenCompleted" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:HudState.Completed}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Thumbnail" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource HudEdgeBrush}" />
            <Setter Property="Background" Value="{StaticResource HudSurfaceBrush}" />
        </Style>
    </Window.Resources>

    <!-- 그림자 자리를 남긴다. 투명한 여백은 클릭이 통과한다. -->
    <Grid Margin="16">

        <!-- 실행 중 / 일시정지 -->
        <Border Style="{StaticResource ShowWhenLive}"
                CornerRadius="23" Padding="7,7,7,7" BorderThickness="1"
                Background="{StaticResource HudBackgroundBrush}"
                BorderBrush="{StaticResource HudEdgeBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Grid Width="32" Height="32">
                    <controls:ProgressRing Style="{StaticResource ShowWhenRunning}"
                                           Progress="{Binding Progress}"
                                           StrokeThickness="3.5"
                                           TrackBrush="#26FFFFFF"
                                           IndicatorBrush="{StaticResource HudAccentBrush}" />
                    <Grid Style="{StaticResource ShowWhenPaused}">
                        <Ellipse Width="20" Height="20" Fill="{StaticResource HudWarningBrush}" Opacity="0.2" />
                        <Ellipse Width="10" Height="10" Fill="{StaticResource HudWarningBrush}" />
                    </Grid>
                </Grid>

                <Grid Margin="10,0,14,0" VerticalAlignment="Center" MinWidth="104">
                    <StackPanel Style="{StaticResource ShowWhenRunning}">
                        <TextBlock FontSize="14" FontWeight="SemiBold">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} / {1}">
                                    <Binding Path="Current" />
                                    <Binding Path="Total" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <TextBlock Text="{Binding RemainingText}" FontSize="11"
                                   Foreground="{StaticResource HudMutedBrush}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource ShowWhenPaused}">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource HudWarningBrush}"
                                   Text="{Binding Current, StringFormat='일시정지 · {0}장 저장'}" />
                        <TextBlock Text="대상 창으로 돌아가 F7 또는 ▶" FontSize="11"
                                   Foreground="{StaticResource HudMutedBrush}" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Thumbnail}" Width="40" Height="28" Margin="0,0,10,0">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding LastThumbnail}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <Button Style="{StaticResource HudIconButton}" Content="&#xE769;"
                        Command="{Binding PauseCommand}" ToolTip="일시정지"
                        Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource HudPrimaryIconButton}" Content="&#xE768;"
                        Command="{Binding ResumeCommand}" ToolTip="대상 창으로 돌아가 재개"
                        Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource HudIconButton}" Content="&#xE71A;" Margin="6,0,0,0"
                        Command="{Binding StopCommand}" ToolTip="중지 (F8)" />
            </StackPanel>
        </Border>

        <!-- 완료 -->
        <Border Style="{StaticResource ShowWhenCompleted}"
                Width="344" CornerRadius="22" Padding="14" BorderThickness="1"
                Background="{StaticResource HudBackgroundBrush}"
                BorderBrush="{StaticResource HudEdgeBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" />
            </Border.Effect>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="58" Height="44">
                        <Border Style="{StaticResource Thumbnail}" Width="50" Height="36" Opacity="0.55">
                            <Border.RenderTransform>
                                <RotateTransform Angle="-9" CenterX="25" CenterY="18" />
                            </Border.RenderTransform>
                        </Border>
                        <Border Style="{StaticResource Thumbnail}" Width="50" Height="36" Opacity="0.8">
                            <Border.RenderTransform>
                                <RotateTransform Angle="5" CenterX="25" CenterY="18" />
                            </Border.RenderTransform>
                        </Border>
                        <Border Style="{StaticResource Thumbnail}" Width="50" Height="36">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding LastThumbnail}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse Fill="{StaticResource HudSuccessBrush}" />
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" FontSize="9"
                                           HorizontalAlignment="Center" Foreground="{StaticResource HudOnAccentBrush}" />
                            </Grid>
                            <TextBlock Text="{Binding CompletedTitle}" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding CompletedDetail}" FontSize="12" Margin="0,3,0,0"
                                   Foreground="{StaticResource HudMutedBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource HudIconButton}" Width="28" Height="28"
                            Background="Transparent" Foreground="{StaticResource HudMutedBrush}"
                            Content="&#xE711;" FontSize="10" VerticalAlignment="Top"
                            Command="{Binding CloseCommand}" ToolTip="닫기" />
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Style="{StaticResource HudButton}" Content="PDF 열기" MinWidth="96" Margin="0,0,8,0"
                            Command="{Binding OpenPdfCommand}"
                            Visibility="{Binding CanOpenPdf, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource HudPrimaryButton}" Content="폴더 열기" MinWidth="96"
                            Command="{Binding OpenFolderCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
