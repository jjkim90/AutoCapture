<Window x:Class="AutoCapture.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:AutoCapture.Wpf.Controls"
        mc:Ignorable="d"
        Title="AutoCapture"
        Width="440" Height="720"
        MinWidth="400" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontSize="14">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding TaskbarProgressState}"
                         ProgressValue="{Binding TaskbarProgressValue}"/>
    </Window.TaskbarItemInfo>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,12,16,16">

                <!-- 캡처 영역 -->
                <Border Style="{StaticResource CardBorder}" Padding="12"
                        DataContext="{Binding AreaSelection}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="132"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Height="84" CornerRadius="4" ClipToBounds="True"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                Background="{DynamicResource ControlAltFillColorSecondaryBrush}">
                            <Grid>
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE722;" FontSize="24"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}"/>
                                <Image Source="{Binding Preview}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <!-- 선택 전 -->
                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Text="캡처 영역 없음" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <TextBlock Text="저장할 화면을 드래그해서 고르세요" Style="{StaticResource RowCaption}"
                                           TextWrapping="Wrap"/>
                                <Button Command="{Binding SelectAreaCommand}" Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{DynamicResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8B3;" Margin="0,0,8,0"/>
                                        <TextBlock Text="영역 선택"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- 선택 후 -->
                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} × {1}">
                                            <Binding Path="Width"/>
                                            <Binding Path="Height"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Text="입력 대상" Style="{StaticResource RowCaption}"/>
                                <TextBlock Text="{Binding Target.Title, FallbackValue='영역 중앙에서 창을 찾지 못했습니다'}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Target.Title}"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Button Command="{Binding SelectAreaCommand}" Margin="0,8,0,0"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8B3;" Margin="0,0,8,0"/>
                                        <TextBlock Text="다시 선택"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 캡처 설정 -->
                <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0"
                        DataContext="{Binding CaptureSettings}">
                    <StackPanel>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="페이지 수" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                            <controls:NumberStepper Grid.Column="1" Value="{Binding CaptureCount}"
                                                    Minimum="1" Maximum="500" DefaultValue="10" Unit="장"
                                                    AutomationProperties.Name="페이지 수"/>
                        </Grid>
                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="넘김 간격" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
                            <controls:NumberStepper Grid.Column="1" Value="{Binding IntervalSeconds}"
                                                    Minimum="1" Maximum="60" DefaultValue="5" Unit="초"
                                                    AutomationProperties.Name="넘김 간격(초)"/>
                        </Grid>
                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="넘김 키" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="저장 후 대상 창에 보냄" Style="{StaticResource RowCaption}"/>
                            </StackPanel>
                            <controls:KeySelectionControl Grid.Column="1" VerticalAlignment="Center"
                                                          SelectedKey="{Binding AutoInputKey, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="저장 위치" Style="{StaticResource RowLabel}"/>
                                <TextBlock ToolTip="{Binding SaveFolderPath}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource RowCaption}">
                                            <Setter Property="Text" Value="{Binding SaveFolderPath}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SaveFolderPath}" Value="">
                                                    <Setter Property="Text" Value="폴더를 선택하세요"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding SelectFolderCommand}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" Margin="0,0,8,0"/>
                                    <TextBlock Text="변경"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="파일 이름" Style="{StaticResource RowLabel}"/>
                                <TextBlock Style="{StaticResource RowCaption}"
                                           Text="{Binding FileNamePrefix, StringFormat='{}{0}_날짜_시각.png'}"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Width="140" VerticalAlignment="Center"
                                     AutomationProperties.Name="파일 이름 접두사"
                                     Text="{Binding FileNamePrefix, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Border Style="{StaticResource RowDivider}"/>

                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="PDF로 묶기" Style="{StaticResource RowLabel}"/>
                                <TextBlock Text="끝나면 저장한 PNG를 PDF 한 개로 합침" Style="{StaticResource RowCaption}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      AutomationProperties.Name="PDF로 묶기"
                                      IsChecked="{Binding SaveAsPdf}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 실행 영역 -->
        <Border Grid.Row="1" Padding="16,12,16,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <StackPanel>
                <!-- 완료 결과 배너: 다음 실행을 시작하거나 닫을 때까지 남는다 -->
                <Border DataContext="{Binding MacroControl}" Margin="0,0,0,10" Padding="12,10,6,10"
                        CornerRadius="6" BorderThickness="1"
                        Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="22" Height="22" Margin="0,1,10,0" VerticalAlignment="Top">
                            <Ellipse Fill="{DynamicResource SystemFillColorSuccessBrush}"/>
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" FontSize="11"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorInverseBrush}"/>
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding LastResult.Title}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{Binding LastResult.Detail}" FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Command="{Binding OpenResultFolderCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" Margin="0,0,6,0"/>
                                        <TextBlock Text="폴더 열기"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding OpenResultPdfCommand}" Margin="6,0,0,0"
                                        Visibility="{Binding LastResult.HasPdf, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xEA90;" Margin="0,0,6,0"/>
                                        <TextBlock Text="PDF 열기"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" VerticalAlignment="Top" Padding="6" MinWidth="0" MinHeight="0"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding DismissResultCommand}" ToolTip="닫기">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" FontSize="10"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock DataContext="{Binding MacroControl}"
                           Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusMessage}"
                           Visibility="{Binding HasResult, Converter={StaticResource InverseBoolToVisibility}}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                <ProgressBar DataContext="{Binding MacroControl}" Margin="0,8,0,0"
                             Value="{Binding CurrentCaptureCount, Mode=OneWay}"
                             Maximum="{Binding TotalCaptureCount, Mode=OneWay}"
                             Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}"/>

                <Grid Margin="0,10,0,0" DataContext="{Binding MacroControl}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{DynamicResource AccentButtonStyle}" Height="40"
                            HorizontalAlignment="Stretch"
                            Command="{Binding StartMacroCommand}"
                            ToolTip="시작 (F7)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" Margin="0,0,8,0"/>
                            <TextBlock Text="시작" FontWeight="SemiBold"/>
                            <TextBlock Text="F7" Margin="10,0,0,0" Opacity="0.7" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Height="40" Margin="8,0,0,0" MinWidth="96"
                            Command="{Binding StopMacroCommand}"
                            ToolTip="중지 (F8)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE71A;" Margin="0,0,8,0"/>
                            <TextBlock Text="중지"/>
                            <TextBlock Text="F8" Margin="10,0,0,0" Opacity="0.7" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="{Binding CaptureSettings.EstimatedDurationText}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
